%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d859fd3efd8d0749aacf50f4ac67b54, type: 3}
  m_Name: Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::ResearcherDialogue
  lines:
  - id: A1
    speaker: Reasearcher Lee
    text: "\uAC70\uAE30 \uB204\uAD6C \uC788\uB098\uC694?\r\n\uC800\uB294 7\uAD6C\uC5ED
      \uC218\uC11D \uC5F0\uAD6C\uC6D0 \uC774 \uBC15\uC0AC\uC785\uB2C8\uB2E4.\r\n\uBC29\uAE08
      \uC5F0\uAD6C\uC18C \uB0B4\uC5D0 \uC0AC\uACE0\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4.\r\n\uC800\uB294
      \uACA9\uB9AC \uAD6C\uC5ED\uC5D0 \uAC07\uD600\uC11C... \uD63C\uC790\uC11C\uB294
      \uC544\uBB34\uAC83\uB3C4 \uD560 \uC218 \uC788\uB294\uAC8C \uC5C6\uC5B4\uC694.\r\n\uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.
      \uC5F0\uAD6C\uC18C \uC2DC\uC2A4\uD15C\uC744 \uBCF5\uAD6C\uD558\uB294 \uB370
      \uB3C4\uC6C0\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.\r\n\uB2F9\uC2E0\uB4E4\uC774
      \uC774 \uC5F0\uAD6C\uC18C\uC758 \uC720\uC77C\uD55C \uD76C\uB9DD\uC785\uB2C8\uB2E4. "
    duration: 23
    voiceClip: {fileID: 8300000, guid: 201116e7e88f7d340985395027f590fa, type: 3}
  - id: A2
    speaker: Reasearcher Lee
    text: "\uC6B0\uC120 \uAE09\uD55C \uAC83\uBD80\uD130 \uD569\uC2DC\uB2E4.\r\n\uC55E\uC5D0
      \uC788\uB294 \uBA54\uC778 \uB514\uC2A4\uD50C\uB808\uC774 \uD328\uB110\uC744
      \uCC3E\uC73C\uC138\uC694.\r\n\uADF8\uB9AC\uACE0 '\uC548\uC815\uD654 \uBC84\uD2BC\uC744
      \uB20C\uB7EC\uC57C \uD569\uB2C8\uB2E4.\r\n\uC9C0\uAE08 \uC2DC\uC124 \uC804\uCCB4\uAC00
      \uBD88\uC548\uC815\uD558\uAC8C \uB3CC\uC544\uAC00\uACE0 \uC788\uC5B4\uC11C,\r\n\uBE68\uB9AC
      \uD589\uB3D9\uD558\uC9C0 \uC54A\uC73C\uBA74\u2014"
    duration: 12
    voiceClip: {fileID: 8300000, guid: deed273aa665eee4086753976b74c273, type: 3}
  - id: A3
    speaker: Reasearcher Lee
    text: "\uB2E4\uC2DC \uB4E4\uB9AC\uC2DC\uB098\uC694? \uBC30\uAD00\uC774 \uD130\uC84C\uC2B5\uB2C8\uB2E4.\r\n\uAC11\uC791\uC2A4\uB7EC\uC6B4
      \uCD9C\uB825 \uBCF5\uAD6C\uAC00 \uB0A1\uC740 \uBC30\uAD00\uC744 \uBC84\uD2F0\uC9C0
      \uBABB\uD558\uAC8C \uD55C \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.\r\n\uC0AC\uC804\uC5D0
      \uC810\uAC80\uC744 \uD588\uC5B4\uC57C \uD588\uB294\uB370. \uC815\uB9D0 \uC8C4\uC1A1\uD569\uB2C8\uB2E4.\r\n\uBC30\uAD00
      \uC774\uC74C\uC0C8\uB97C \uCC3E\uC544\uC11C \uB2E4\uC2DC \uB9C9\uC544\uC8FC\uC2E4
      \uC218 \uC788\uB098\uC694?\t"
    duration: 14
    voiceClip: {fileID: 8300000, guid: 5d01d7da641998c44827d2cafe9cee72, type: 3}
  - id: A4
    speaker: Reasearcher Lee
    text: "\uC2DC\uC124\uC758 \uC5D0\uB108\uC9C0 \uC218\uC900\uC774 \uC548\uC815\uD654\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774\uC81C \uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD574\uC57C
      \uD569\uB2C8\uB2E4"
    duration: 5
    voiceClip: {fileID: 8300000, guid: c5015f73ac3b5004ea6c2082865031ad, type: 3}
  - id: B1
    speaker: Reasearcher Lee
    text: "\uC774\uB7F0, \uC0DD\uBB3C\uB4E4\uC774 \uD0C8\uCD9C\uD588\uC2B5\uB2C8\uB2E4!
      \uB2E4\uC2DC \uACA9\uB9AC \uCF00\uC774\uC9C0\uC5D0 \uB123\uC5B4\uC57C \uD574\uC694!
      \uD558\uC9C0\uB9CC \uC62C\uBC14\uB978 \uCF00\uC774\uC9C0\uC5D0 \uB123\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uB0A0\uC544\uB2E4\uB2C8\uB294 \uC0DD\uBB3C\uC774 \uB2E8\uC11C\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC83 \uAC19\uB124\uC694"
    duration: 10
    voiceClip: {fileID: 8300000, guid: 8c073632fa832f44aaa6baf70857d9d7, type: 3}
  - id: B2
    speaker: Reasearcher Lee
    text: "\uC798 \uD558\uC168\uC2B5\uB2C8\uB2E4. \uC0DD\uBB3C\uB4E4\uC744 \uB2E4\uC2DC
      \uCF00\uC774\uC9C0\uC5D0 \uB123\uC5C8\uC73C\uB2C8 \uC774\uC81C \uB2E4\uC74C
      \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    duration: 7
    voiceClip: {fileID: 8300000, guid: 5ad2331c04387044fae1b54c5617b8ec, type: 3}
